# ==============================================================================
# UNIVERSAL AI ISSUE RUNNER - CONFIGURAZIONE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GITHUB ACTIONS SELF-HOSTED RUNNER
# ------------------------------------------------------------------------------
# Inserisci l'URL del tuo repository o dell'intera organizzazione:
# Per singolo repository: https://github.com/vibe-maribit/issue-runner
# Per intera organizzazione: https://github.com/vibe-maribit
GITHUB_URL=https://github.com/vibe-maribit/issue-runner

# Metodo Consigliato: GitHub Personal Access Token (PAT)
# Il PAT permette al runner di richiedere automaticamente un token di registrazione
# a ogni avvio e di deregistrarsi pulitamente allo shutdown.
# Permessi richiesti:
# - Se registri su Repository: 'repo' (Full control)
# - Se registri su Organization: 'admin:org'
GITHUB_PAT=ghp_yourPersonalAccessTokenHere

# In alternativa al PAT, puoi inserire un RUNNER_TOKEN temporaneo (valido 1 ora)
# generato da Settings > Actions > Runners > New runner:
# RUNNER_TOKEN=BXXXXXXXXXXXXXXX

# Nome del runner visibile nella dashboard GitHub Actions:
GITHUB_RUNNER_NAME=vibe-ai-runner-box

# Etichette del runner (usate nei workflow in 'runs-on'):
# Con queste etichette, il runner risponde sia a job generici sia specifici per agente!
GITHUB_RUNNER_LABELS=self-hosted,linux,x64,issue-runner,antigravity,agy,claude,opencode,pi-agent,codex

# ------------------------------------------------------------------------------
# 2. GITEA ACT RUNNER (Opzionale per istanze Gitea Self-Hosted)
# ------------------------------------------------------------------------------
# URL dell'istanza Gitea (es. https://gitea.example.com o http://192.168.1.100:3000)
GITEA_INSTANCE_URL=https://gitea.example.com

# Token di registrazione runner generato da:
# - Amministrazione Sito > Actions > Runner (per Global Runner)
# - Organizzazione > Impostazioni > Actions > Runner (per Org Runner)
GITEA_RUNNER_TOKEN=yourGiteaRunnerRegistrationTokenHere

GITEA_RUNNER_NAME=vibe-gitea-ai-runner
GITEA_RUNNER_LABELS=self-hosted:host,issue-runner:host,antigravity:host,agy:host,claude:host,opencode:host,pi-agent:host

# ------------------------------------------------------------------------------
# 3. PERCORSI SULL'HOST PER LE SESSIONI DEGLI AGENTI AI
# ------------------------------------------------------------------------------
HOST_HOME=/home/nicola
HOST_GEMINI_DIR=/home/nicola/.gemini
HOST_CLAUDE_DIR=/home/nicola/.claude
HOST_CLAUDE_CONFIG=/home/nicola/.claude.json
HOST_OPENCODE_CONFIG=/home/nicola/.config/opencode
HOST_OPENCODE_DIR=/home/nicola/.opencode
HOST_PI_DIR=/home/nicola/.pi
